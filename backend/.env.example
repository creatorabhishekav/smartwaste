# ---- SmartWaste 360 backend environment -------------------------------
# Copy to .env and adjust. Never commit real secrets.

# Use PostgreSQL in production; SQLite is used automatically when unset.
# Leave DATABASE_URL unset to fall back to SQLite at backend/smartwaste.db.
# On Render the filesystem is ephemeral, so SQLite data is DEMO data only and
# is re-created by SEED_ON_STARTUP on every deploy.
# DATABASE_URL=postgresql+psycopg2://smartwaste:smartwaste@localhost:5432/smartwaste
DATABASE_URL=sqlite:///./smartwaste.db

# Auth
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - comma separated list of allowed origins (no wildcards in production)
# LOCAL:  http://localhost:5173,http://127.0.0.1:5173
# RENDER: https://<your-frontend-service>.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render supplies PORT at runtime. Local start command stays unchanged:
#   python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
# Render start command binds every interface:
#   uvicorn app.main:app --host 0.0.0.0 --port $PORT

# AI - leave empty to use the deterministic DEMO provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# auto | gemini | demo
AI_PROVIDER=auto

# Optional computer-vision verification microservice (falls back to demo CV)
VERIFY_SERVICE_URL=

# Uploads
MAX_UPLOAD_BYTES=5242880

# Seed demo data on startup
SEED_ON_STARTUP=true
