# Frontend environment
#
# This file is a TEMPLATE. `.env` is gitignored, so it is never deployed.
# Copy it to `.env` for local development: `copy .env.example .env`

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT (optional)
# ---------------------------------------------------------------------------
# If VITE_API_URL is left unset, the app calls same-origin `/api` and the Vite
# dev server proxies it to VITE_BACKEND_ORIGIN. That is the default and needs no
# configuration. Set it explicitly only if you want the browser to talk to the
# backend directly (required for real browser geolocation over plain HTTP).
#
# VITE_API_URL=http://127.0.0.1:8000

# Dev-server proxy target only. Never used in a production build.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# PRODUCTION (Render Static Site) - set in the Render dashboard, not in git
# ---------------------------------------------------------------------------
# Must be the public origin of the deployed FastAPI service, no trailing slash.
# VITE_API_URL=https://smartwaste-360-api.onrender.com
#
# Vite inlines VITE_* variables at BUILD time, so on a static site this value is
# baked into dist/assets/*.js. Changing it in Render requires a rebuild.
